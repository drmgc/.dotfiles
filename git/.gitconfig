[user]
	name = Sergey Naumov
	email = drmgc@yandex.ru
[core]
	editor = vim
[alias]
	co   = checkout
	ci   = commit
	st   = status
	hst  = status -s
	br   = branch
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
	type = cat-file -t
	dump = cat-file -p
	dft  = difftool
	sm   = submodule
[diff]
	tool = difftastic
	; external = difft
[difftool]
	prompt = false
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
[pager]
	difftool = true
[credential]
	helper = cache --timeout=3600
[init]
	defaultBranch = main

[includeIf "gitdir:~/prj/"]
	path = ~/prj/.gitconfig

[http]
	postBuffer = 4096M
	version = HTTP/1.1
